    <!--
    Sink configuration:

    Default values:
        Bloomberg="0"
        Type="" - treated as "File"
        Filename=""
        Count="0"
        MaxSize=2000000
    
    Id = name of the sink

    Enabled = 0,1
            
    Scope:
        0 - all
        1 - pc only
        2 - consoles only
            
    Bloomberg:
        0 - do not add to bloomberg
        1 - always add to bloomberg
            
    Type:
        1. File - regular file on disk. Attributes: Filename - if empty, defaulting to "nomad_log-<sinkId>-{login}.txt".
        2. Memory - circular buffer in memory. Attributes: MaxSize - size of buffer in memory. Filename(optional) - file to dump this log on shutdown or crash.
        3. MultiFile - kind of circular buffer built on files (very usefull for big logs on consoles). 
            Attributes: Count = number of files in log. MaxSize - max size of Each file. Filename - file name pattern, default is "nomad_log-<sinkId>-{login}-{num}.txt".
            
    Tags:
        {login} - login (empty on consoles). If the -login argument is provided on start up then the argument value is used, otherwise the system user name is used and if there is more that one instance, login will be truncated and {pid} will be added. (kindof "{login}-{pid})
        {pid} - process id (empty on consoles)
        {num} - file index in MultiFile log.
-->
      
    <ChannelSinks>
      <Sink Id="" Bloomberg="1" Type="Memory" MaxSize="5000000" FileName="nomad_log-default-{login}.txt" TypeForNonValidVersion="File" />
      <Sink Id="online" Bloomberg="1" Type="Memory" MaxSize="5000000" FileName="nomad_log-online-{login}.txt" TypeForNonValidVersion="File" />
      <Sink Id="replication" Bloomberg="1" Type="Memory" MaxSize="5000000" FileName="nomad_log-replication-{login}.txt" TypeForNonValidVersion="File" />
      <Sink Id="challenge" Bloomberg="1" Type="Memory" MaxSize="5000000" FileName="nomad_log-challenges-{login}.txt" TypeForNonValidVersion="File" />
    </ChannelSinks>
      
