<gpu_db>

	<!-- 
			 This table is used to lower the rating of a gpu based on it's memory. 
			 We first get the GPU rating by using the vendor and model id. 
			 Then based on the rating, we will get the right node <gpu_rating> from the table below.
			 Ex; You have a very high rated gpu. We will take the <gpu_rating value="3"> node. If your GPU has more then 640 you are okay.
			 If you have between 320 and 640 Mb your gpu rating will go down to high. If your GPU has between 256 and 320, it's rating will go down to medium. Etc.
	-->
	<gpu_memory_rating>
		<gpu_rating value="0">
		</gpu_rating>
		<gpu_rating value="1">
			<low 			value="256"/>
		</gpu_rating>
		<gpu_rating value="2">
